extern void printInt(int val);
extern void printNewlines( int num);
extern void printFloat(float val);


export int main()
{

    int intValue = 5;
    float floatValue = 4.00;
    bool boolValue = false;
    float floatFalseValue = 0.00;


    // Type casting
    int castedIntFromFloat = (int)floatValue;
    int castedIntFromBool = (int)boolValue;
    float castedFloatFromInt = (float)intValue;
    float castedFloatFromBool = (float)boolValue;
    bool castedBoolFromInt = (bool)intValue;
    bool castedBoolFromFloat = (bool)floatFalseValue;


    printInt(castedIntFromFloat);
    printNewlines(1);
    printInt(castedIntFromBool);
    printNewlines(1);

    printFloat(castedFloatFromInt);
    printNewlines(1);
    printFloat(castedFloatFromBool);
    printNewlines(1);

    if(castedBoolFromInt == true) {
        printInt(10);
    }

    if(castedBoolFromFloat == false) {
        printInt(20);
    }


    printNewlines(1);

    return 0;
}