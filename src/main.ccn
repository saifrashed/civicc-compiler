start phase EntryPoint {
    info = "Denotes the entry point of your compiler",
    
    actions {
        pass SPdoScanParse;
        Print;
    }
};

traversal Print {
    uid = PRT
};

phase Demo {
    actions { 
        traversal RenameIdentifiers {
            uid = RI,
            nodes = { Var, VarLet }
        };

        traversal SumInts {
            uid = SI,
            nodes = { Stmts, Num },
            travdata {
                int sum
            }
        };

        traversal OptSubstraction {
            uid = OS,
            nodes = { Binop }
        };
    }
};


/*** AST ***/

enum monop_type {
    prefix = MO,
    values {
        not, neg
    }
};

enum binop_type {
    prefix = BO,
    values {
        add, sub, mul, div, mod, lt, le, gt, ge, eq, ne,
        and, or
    }
};

enum basic_type {
    prefix = BT,
    values {
        int, float, bool
    }
};

enum void_type {
    prefix = VT,
    values {
        void
    }
};

nodeset Expr = {Num, Float, Bool, Binop, Monop, Var};
nodeset Stmt = {Assign, IfStmt, FunCall, WhileLoop, DoWhileLoop, ForLoop, ReturnStmt};
nodeset Declaration = {FunDec, FunDef, GlobalDec, GlobalDef};


nodeset BasicType = {NumType, FloatType, BoolType};
nodeset ReturnType = {NumType, FloatType, BoolType} | {VoidType};

// Nodes you want to be able to link to from your symbol table.
nodeset Link = Expr | Stmt;


// Top level nodes

root node Program {
    children {
        Declarations declarations { constructor, mandatory }
    }
};

node Declarations {
    children {
        Declaration Declaration { constructor, mandatory },
        Declarations next { constructor }
    }
};

node Stmts {
    children {
        Stmt stmt { constructor, mandatory },
        Stmts next { constructor }
    }
};

node Block {
    children {
        Stmt stmt { constructor, mandatory },
        Stmts next { constructor }
    }
};

node Param {
    children {
        BasicType type { constructor, mandatory },
        Var id { constructor, mandatory }
    }
};

node Params {
    children {
        Param arg { constructor },
        Params next { constructor }
    }
};

node Exprs {
    children {
        Expr expr { constructor },
        Exprs next { constructor }
    }
};

node FunHeader {
    children {
        ReturnType type { constructor, mandatory },
        Var id { constructor, mandatory },
        Params next { constructor }
    }
};

node FunBody {
    children {
        VarDecs nextdecl { constructor },
        Stmts next { constructor }
    }
};

node VarDec {
    children {
        BasicType type { constructor, mandatory },
        Var id { constructor, mandatory },
        Expr expr { constructor }
    }
};

node VarDecs {
    children {
        VarDec vardec { constructor },
        VarDecs next { constructor }
    }
};

node FunDec {
    children {
        ExternType dectype { constructor },
        FunHeader funheader { constructor, mandatory },
        Var id { constructor, mandatory }
    }
};

node FunDef {
    children {
        ExportType deftype { constructor },
        FunHeader funheader { constructor, mandatory },
        FunBody funbody { constructor }
    }
};

node GlobalDec {
    children {
        ExternType dectype { constructor },
        BasicType type { constructor, mandatory },
        Var id { constructor, mandatory }
    }
};

node GlobalDef {
    children {
        ExportType deftype { constructor },
        Var id { constructor, mandatory },
        Expr expr { constructor }
    }
};

// Statements

node Assign {
    children {
        VarLet let { constructor },
        Expr expr { constructor, mandatory }
    }
};

node IfStmt {
    children {
        Expr expr { constructor, mandatory },
        Block ifBlock { constructor, mandatory },
        Block elseBlock { constructor }
    }
};

node FunCall {
    children {
        Var funname { constructor, mandatory },
        Exprs arg { constructor }
    }
};

node WhileLoop {
    children {
        Expr loopcondition { constructor, mandatory },
        Block loopbody { constructor, mandatory }
    }
};

node DoWhileLoop {
    children {
        Block loopbody { constructor, mandatory },
        Expr loopcondition { constructor, mandatory }
    }
};

node ForLoop {
    children {
        VarDec initdecl { constructor, mandatory },
        Expr loopcondition { constructor, mandatory },
        Assign assign { constructor, mandatory },
        Block loopbody { constructor, mandatory }
    }
};

node ReturnStmt {
    children {
        Expr expr { constructor }
    }
};


// Type keyword nodes

node NumType {
    attributes {
        string name { constructor }
    }
};

node FloatType {
   attributes {
        string name { constructor }
    }
};

node BoolType {
   attributes {
        string name { constructor }
    }
};

node VoidType {
   attributes {
        string name { constructor }
    }
};

node ExportType {
   attributes {
        string name { constructor }
    }
};

node ExternType {
   attributes {
        string name { constructor }
    }
};


// The rest

node Binop {
    children {
        Expr left  { constructor, mandatory },
        Expr right { constructor, mandatory }
    },
    
    attributes {
        binop_type type { constructor }
    }
};

node Monop {
    children {
        Expr left  { constructor, mandatory },
        Expr right { constructor, mandatory }
    },
    
    attributes {
        monop_type type { constructor }
    }
};

// Variable in assignment.
node VarLet {
    attributes {
        string name { constructor },
        Link decl
    }
};

// Variable in an expression.
node Var {
    attributes {
        string name { constructor },
        Link decl
    }
};

node Num {
    attributes {
        int val { constructor }
    }
};

node Float {
    attributes {
        float val { constructor }
    }
};

node Bool {
    attributes {
        bool val { constructor }
    }
};

/* Symbol table entry
 * TODO: fill in.
node Ste {

}
*/



